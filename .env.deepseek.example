APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=sqlite+aiosqlite:///./data/open-intent-router.db
STORAGE_BACKEND=database

REGISTRY_BACKEND=file
REGISTRY_FILE_PATH=./config/agents.example.yaml
REGISTRY_FILE_FALLBACK_ON_EMPTY=false

ROUTER_LLM_PROVIDER=openai_compatible
ROUTER_LLM_MODEL=deepseek-chat
ROUTER_LLM_BASE_URL=https://api.deepseek.com
ROUTER_LLM_API_KEY=replace-with-real-key
ROUTER_LLM_TIMEOUT_SECONDS=20
ROUTER_PROMPT_FILE=./config/prompts/router.zh.yaml

ROUTE_MODE=route_and_invoke
# Optional for local loopback development. Required outside APP_ENV=local.
ADMIN_API_TOKEN=

ROUTER_MAX_HOST_HISTORY_MESSAGES=20
ROUTER_MAX_AGENT_HISTORY_MESSAGES=12
ROUTER_MAX_RECENT_EVENTS=10
ROUTER_MAX_RECENT_RESULTS=5

# Context Pack budget controls. Source budgets use comma-separated source:tokens pairs,
# e.g. evidence:600,agent_history:500,host_history:400
CONTEXT_DEFAULT_TOKEN_BUDGET=2000
CONTEXT_MAX_TOKEN_BUDGET=8000
CONTEXT_DEFAULT_SOURCE_BUDGETS=
CONTEXT_CHARS_PER_TOKEN=4
CONTEXT_PER_ITEM_TOKEN_LIMIT=512
CONTEXT_PER_ITEM_CHAR_LIMIT=2000
CONTEXT_ALLOW_REQUEST_BUDGET_OVERRIDE=true
CONTEXT_ALLOW_SUMMARY_PLACEHOLDER=true

EVIDENCE_PROVIDER_ENABLED=false
EVIDENCE_FIXED_QUESTIONS_PATH=./config/fixed_questions.example.yaml
