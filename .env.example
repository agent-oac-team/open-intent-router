APP_ENV=local
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174

# 默认本地开发可用 SQLite；真实 PostgreSQL 联调建议使用 sql/postgresql_schema.sql 创建 OIR 专属库。
DATABASE_URL=sqlite+aiosqlite:///./data/open-intent-router.db
# DATABASE_URL=postgresql+asyncpg://oir:replace-with-local-password@127.0.0.1:5432/oir
STORAGE_BACKEND=database

REGISTRY_BACKEND=file
REGISTRY_FILE_PATH=./config/agents.example.yaml
REGISTRY_FILE_FALLBACK_ON_EMPTY=false

ROUTER_LLM_PROVIDER=mock
ROUTER_LLM_MODEL=mock-router
ROUTER_LLM_BASE_URL=
ROUTER_LLM_API_KEY=
ROUTER_LLM_TIMEOUT_SECONDS=20
ROUTER_PROMPT_FILE=./config/prompts/router.zh.yaml

# 如需通过 OpenAI-compatible client 使用 DeepSeek，可从 .env.deepseek.example
# 复制本地值，或覆盖以下字段：
# ROUTER_LLM_PROVIDER=openai_compatible
# ROUTER_LLM_MODEL=deepseek-chat
# ROUTER_LLM_BASE_URL=https://api.deepseek.com
# ROUTER_LLM_API_KEY=replace-with-real-key

ROUTE_MODE=route_and_invoke
# Runtime Catalog 在应用退出时按逆序释放 Adapter 的总 deadline（秒）。
RUNTIME_CATALOG_SHUTDOWN_TIMEOUT_SECONDS=5
# 本地 loopback 开发可留空；非 APP_ENV=local 环境必须配置。
ADMIN_API_TOKEN=
# 受信网关使用该 secret 签发 oir-principal-v1 Envelope；非 local Native 请求必须携带
# X-OIR-Principal-Envelope 与 X-OIR-Principal-Signature。请求 body 不能提供权限。
NATIVE_PRINCIPAL_SECRET=
# 迁移期 owner-only X-User-ID/X-Tenant-ID 签名；不会恢复 body roles/groups/entitlements。
MEMORY_IDENTITY_SECRET=
# Execution Ticket 只保存 hash；Native Event 使用 Header 回传，Core 不提供签发 API。
EXECUTION_TICKET_SECRET=
DELEGATED_RUN_TIMEOUT_INTERVAL_SECONDS=1
DELEGATED_RUN_TIMEOUT_BATCH_SIZE=100

ROUTER_MAX_HOST_HISTORY_MESSAGES=20
ROUTER_MAX_AGENT_HISTORY_MESSAGES=12
ROUTER_MAX_RECENT_EVENTS=10
ROUTER_MAX_RECENT_RESULTS=5

# Context Pack 预算控制。Source budgets 使用逗号分隔的 source:tokens，
# 例如 evidence:600,agent_history:500,host_history:400
CONTEXT_DEFAULT_TOKEN_BUDGET=2000
CONTEXT_MAX_TOKEN_BUDGET=8000
CONTEXT_DEFAULT_SOURCE_BUDGETS=
CONTEXT_CHARS_PER_TOKEN=4
CONTEXT_PER_ITEM_TOKEN_LIMIT=512
CONTEXT_PER_ITEM_CHAR_LIMIT=2000
CONTEXT_ALLOW_REQUEST_BUDGET_OVERRIDE=true
CONTEXT_ALLOW_SUMMARY_PLACEHOLDER=true
CONTEXT_PIPELINE_MODE=legacy
CONTEXT_POLICY_VERSION=context-policy-v1
CONTEXT_BUDGET_VERSION=context-budget-v1
CONTEXT_PROJECTION_VERSION=context-projection-v1
CONTEXT_MODEL_WINDOW_TOKENS=16000
CONTEXT_SYSTEM_RESERVE_TOKENS=1200
CONTEXT_SCHEMA_RESERVE_TOKENS=1400
CONTEXT_RULES_RESERVE_TOKENS=600
CONTEXT_OUTPUT_RESERVE_TOKENS=1200
CONTEXT_AGENT_TOKEN_BUDGET=3000

EVIDENCE_PROVIDER_ENABLED=false
EVIDENCE_FIXED_QUESTIONS_PATH=./config/fixed_questions.example.yaml

# 记忆行为只由 MEMORY_MODE=off|observe|on 控制。低层 worker/recall/formation 开关已退役。
# 记忆闭环默认走 OIR repository；真实接入 mem0 时改为 mem0。
# 本地 Milvus 统一使用 Milvus Lite 文件 URI，不要求 standalone Milvus 服务。
MEMORY_MODE=off
MEMORY_STRATEGY_PROVIDER=memory
MEMORY_PREFETCH_TIMEOUT_SECONDS=3.0
MEMORY_DEFAULT_MAX_ITEMS=5
# Memory canonical SQL 与向量/Embedding 配置使用独立 MEMORY_* 命名空间。
# MEMORY_MODE=observe|on 时 MEMORY_DATABASE_URL 必须显式设置；mem0 策略还要求
# MEMORY_MILVUS_URI/COLLECTION 与 MEMORY_EMBEDDING_MODEL/DIMS，缺失则启动失败。
MEMORY_DATABASE_URL=sqlite+aiosqlite:///./data/open-intent-router.db
MEMORY_MILVUS_COLLECTION=oir_memory_vectors
MEMORY_MILVUS_URI=.data/oir_memory_milvus.db
MEMORY_MILVUS_TOKEN=
MEMORY_MILVUS_DB_NAME=
MEMORY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_DIMS=1024
MEMORY_TASK_TTL_DAYS=14
MEMORY_SESSION_SUMMARY_TTL_DAYS=14
MEMORY_ARTIFACT_REFERENCE_TTL_DAYS=14

# 推荐按 off -> observe -> on 顺序上线。
# formation model 使用独立的模型名、版本、prompt 版本和超时；不得在这些字段中写入凭证。
MEMORY_IMPORT_LEGACY_HISTORY_ENABLED=false
MEMORY_FORMATION_WINDOW_TURNS=5
MEMORY_FORMATION_IDLE_SECONDS=30
MEMORY_FORMATION_MODEL=formation-default
MEMORY_FORMATION_MODEL_VERSION=formation-model-v1
MEMORY_FORMATION_PROMPT_VERSION=formation-prompt-v1
MEMORY_FORMATION_POLICY_VERSION=formation-policy-v1
MEMORY_FORMATION_AUTO_THRESHOLD=0.90
MEMORY_FORMATION_PENDING_THRESHOLD=0.70
MEMORY_FORMATION_MODEL_TIMEOUT_SECONDS=20
MEMORY_FORMATION_LEASE_SECONDS=60
MEMORY_FORMATION_MAX_ATTEMPTS=5
MEMORY_FORMATION_RETRY_BASE_SECONDS=5
MEMORY_FORMATION_RETRY_MAX_SECONDS=300

# worker 状态由 MEMORY_MODE 派生；index/TTL maintenance 在三种模式下都保持开启。
MEMORY_MAINTENANCE_INTERVAL_SECONDS=1
MEMORY_FORMATION_SWEEP_INTERVAL_SECONDS=5
MEMORY_CONSOLIDATION_INTERVAL_SECONDS=3600

# Turn Capsule 和 formation prompt 的硬上限。
MEMORY_FORMATION_CAPSULE_USER_CHARS=2000
MEMORY_FORMATION_CAPSULE_ASSISTANT_CHARS=2000
MEMORY_FORMATION_CAPSULE_SUMMARY_CHARS=1000
MEMORY_FORMATION_PROMPT_MAX_CHARS=30000

# 以下 MEMORY_MEM0_* 只保留 mem0 provider 自身的失败、history 与可选 LLM 配置。
# 本地开发建议 false；生产/验收建议 true。完全不设置该变量时 APP_ENV!=local 自动 fail-closed。
MEMORY_MEM0_FAIL_CLOSED=false
MEMORY_MEM0_VECTOR_PROVIDER=milvus

# mem0 SDK 当前文档仍以 SQLite history_db_path 作为内部 history。
# OIR 的 canonical history/ledger 写入 PostgreSQL memory_events；真实联调建议写入 OIR 专属 `oir` database。
# 不要复用 IRS/OAC 的 `oac` database，避免 memory/history 与旧系统数据混杂。
MEMORY_MEM0_HISTORY_BACKEND=postgresql
MEMORY_MEM0_HISTORY_DATABASE_URL=
MEMORY_MEM0_HISTORY_DB_PATH=./data/mem0-history.db

MEMORY_MEM0_EMBEDDER_PROVIDER=openai

# 如 mem0 需要 LLM 做抽取/合并，可按部署环境配置 OpenAI-compatible LLM。
MEMORY_MEM0_LLM_PROVIDER=openai
MEMORY_MEM0_LLM_MODEL=
MEMORY_MEM0_LLM_BASE_URL=
MEMORY_MEM0_LLM_API_KEY=

# Provider-neutral Agent Knowledge 检索预算与瞬时句柄。
KNOWLEDGE_PREFETCH_TIMEOUT_SECONDS=12.0
KNOWLEDGE_DEFAULT_MAX_ITEMS=5
KNOWLEDGE_CONTEXT_HANDLE_TTL_SECONDS=60

# Provider-neutral Knowledge 端口的 knowledge_sys HTTP 实现；Base URL 为空时不构造 Provider。
# 远端必须 HTTPS；同机 PM2 可使用 localhost/127.0.0.1/::1 的 loopback HTTP。
KNOWLEDGE_PROVIDER_BASE_URL=
KNOWLEDGE_PROVIDER_DEADLINE_SECONDS=12
KNOWLEDGE_PROVIDER_JWT_ISSUER=oir
KNOWLEDGE_PROVIDER_JWT_AUDIENCE=knowledge_sys
KNOWLEDGE_PROVIDER_JWT_KEY_ID=
# PEM 与文件路径二选一；私钥绝不由 JWKS、日志或运行时配置接口返回。
KNOWLEDGE_PROVIDER_JWT_PRIVATE_KEY=
KNOWLEDGE_PROVIDER_JWT_PRIVATE_KEY_FILE=
KNOWLEDGE_PROVIDER_JWT_TTL_SECONDS=60
KNOWLEDGE_PROVIDER_CIRCUIT_WINDOW_SECONDS=30
KNOWLEDGE_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
KNOWLEDGE_PROVIDER_CIRCUIT_OPEN_SECONDS=30

# OAC Host Adapter 专有配置。Core 不读取这些变量。
OAC_HOST_ENVIRONMENT=local
OAC_HOST_SHADOW_MODE=off
OAC_HOST_WRITE_FENCE_ENABLED=true
OAC_HOST_WRITE_FREEZE_ENABLED=false
OAC_HOST_OIR_CONTROL_WRITE_ENABLED=true
OAC_HOST_OIR_RUNTIME_WRITE_ENABLED=true
OAC_HOST_STATE_REHEARSAL_DATABASE_URL=
OAC_HOST_STATE_REHEARSAL_KNOWLEDGE_COLLECTION=oir_knowledge_vectors_rehearsal
OAC_HOST_STATE_REHEARSAL_MEMORY_COLLECTION=oir_memory_vectors_rehearsal
OAC_HOST_CUTOVER_WATERMARK=
OAC_HOST_CUTOVER_AUDIT_PATH=.data/oac_cutover_quarantine.jsonl
OAC_HOST_IDENTITY_CURRENT_KEY_ID=
OAC_HOST_IDENTITY_CURRENT_KEY=
OAC_HOST_OIR_IDENTITY_SIGNING_KEY=
# 旧 OAC 部署变量仍由 Host composition 投影给 Core 的共享 Ticket Service；新 Native 部署使用
# 顶部 EXECUTION_TICKET_SECRET。Legacy body/wire 不变。
OAC_HOST_EXECUTION_TICKET_SECRET=
# 逗号分隔的 Host-owned External Executor 逻辑引用；留空时所有 Legacy bot_id fail closed。
OAC_HOST_EXTERNAL_EXECUTOR_REFS=
OAC_HOST_OAC_ADMIN_KEY_ID=
OAC_HOST_OAC_ADMIN_CREDENTIAL=
OAC_HOST_COZE_WORKFLOW_KEY_ID=
OAC_HOST_COZE_WORKFLOW_CREDENTIAL=
OAC_HOST_CLAIMS_VERSION=oac-principal-v1
OAC_HOST_AUTHZ_POLICY_VERSION=oac-authz-v1
OAC_HOST_ADMIN_CLAIMS_VERSION=oac-admin-principal-v1
OAC_HOST_ADMIN_POLICY_VERSION=oac-control-v1
OAC_HOST_COZE_CLAIMS_VERSION=oac-service-principal-v1
OAC_HOST_COZE_POLICY_VERSION=oac-readonly-v1
