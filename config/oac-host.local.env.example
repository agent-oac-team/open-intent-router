# OAC Host Runtime local integration profile. Values are placeholders only.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://oir:replace-with-local-password@127.0.0.1:5432/oir
STORAGE_BACKEND=database
REGISTRY_BACKEND=database
REGISTRY_FILE_FALLBACK_ON_EMPTY=false

KNOWLEDGE_ENABLED=true
KNOWLEDGE_VECTOR_BACKEND=milvus
KNOWLEDGE_MILVUS_URI=.data/oir_knowledge_milvus.db
KNOWLEDGE_MILVUS_COLLECTION=oir_knowledge_vectors
MEMORY_ENABLED=true
MEMORY_RECALL_ENABLED=true
MEMORY_MEM0_MILVUS_URI=.data/oir_memory_milvus.db
MEMORY_MEM0_MILVUS_COLLECTION=oir_memory_vectors
MEMORY_IMPORT_LEGACY_HISTORY_ENABLED=false

OAC_HOST_ENVIRONMENT=local
OAC_HOST_SHADOW_MODE=decision
OAC_HOST_FALLBACK_MODE=read_only
OAC_HOST_IRS_FALLBACK_BASE_URL=http://127.0.0.1:8001
OAC_HOST_WRITE_FENCE_ENABLED=true
OAC_HOST_WRITE_FREEZE_ENABLED=false
OAC_HOST_OIR_CONTROL_WRITE_ENABLED=true
OAC_HOST_IRS_CONTROL_WRITE_ENABLED=false
OAC_HOST_OIR_RUNTIME_WRITE_ENABLED=true
OAC_HOST_IRS_RUNTIME_WRITE_ENABLED=false

# State Rehearsal remains disabled in this profile. When enabled, all three
# values must differ from the primary database and collections above.
OAC_HOST_STATE_REHEARSAL_DATABASE_URL=postgresql+asyncpg://oir_rehearsal:replace-with-local-password@127.0.0.1:5432/oir_rehearsal
OAC_HOST_STATE_REHEARSAL_KNOWLEDGE_COLLECTION=oir_knowledge_vectors_rehearsal
OAC_HOST_STATE_REHEARSAL_MEMORY_COLLECTION=oir_memory_vectors_rehearsal

# Set real values only in an untracked local .env or secret store.
OAC_HOST_IDENTITY_CURRENT_KEY_ID=local-oac-user
OAC_HOST_IDENTITY_CURRENT_KEY=
OAC_HOST_OIR_IDENTITY_SIGNING_KEY=
OAC_HOST_EXECUTION_TICKET_SECRET=
OAC_HOST_OAC_ADMIN_KEY_ID=local-oac-admin
OAC_HOST_OAC_ADMIN_CREDENTIAL=
OAC_HOST_COZE_WORKFLOW_KEY_ID=local-coze-knowledge
OAC_HOST_COZE_WORKFLOW_CREDENTIAL=
OAC_HOST_IRS_FALLBACK_SERVICE_TOKEN=
